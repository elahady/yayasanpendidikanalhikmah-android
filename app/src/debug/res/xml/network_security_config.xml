<?xml version="1.0" encoding="utf-8"?>
<!-- Hanya build debug: HTTP diizinkan ke server pengembangan (emulator 10.0.2.2, atau IP LAN komputer
     saat menguji di HP fisik lewat debug.apiHost). Format ini tidak mendukung wildcard IP, jadi cleartext
     dibuka untuk seluruh build debug. Build rilis tetap HTTPS-only (konfigurasi di src/main). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
